.topbar-btn:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 1px; }
.btn-label { font-size: 11px; font-weight: 700; color: var(--color-text); white-space: nowrap; }

.reading-body {
  flex: 1;
  min-height: 0;
  width: 100%;
